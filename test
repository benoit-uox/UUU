'@Folder("Charge")
Option Explicit

Public Sub GenerateTableauxHeures()
    On Error GoTo errorHandler

    Dim loSource As ListObject
    Set loSource = shImputationSource.ListObjects("Imputation_BDD")

    Dim shDest As Worksheet
    Set shDest = shImputHeureNAV
    shDest.Cells.Clear

    Dim nbCols As Long
    nbCols = loSource.ListColumns.Count

    Dim colRessource As Long
    colRessource = loSource.ListColumns("Ressource").Index
    Dim colTG As Long
    colTG = loSource.ListColumns("TG").Index
    Dim colCharge As Long
    colCharge = loSource.ListColumns("Charge").Index

    Dim firstMonthCol As Long
    firstMonthCol = colCharge + 1

    Dim numMonthCols As Long
    numMonthCols = nbCols - firstMonthCol + 1

    Dim helperColOffset As Long
    helperColOffset = nbCols + 2   ' 1 colonne de séparation, puis les colonnes miroir cachées

    Dim dataSource As Variant
    dataSource = loSource.DataBodyRange.Value

    Dim nbRows As Long
    nbRows = UBound(dataSource, 1)

    Dim headers As Variant
    headers = loSource.HeaderRowRange.Value

    Dim dictRessources As Object
    Set dictRessources = CreateObject("Scripting.Dictionary")

    Dim r As Long
    For r = 1 To nbRows
        Dim ress As String
        ress = dataSource(r, colRessource)
        If Not dictRessources.Exists(ress) Then
            dictRessources.Add ress, Nothing
        End If
    Next r

    Dim currentRow As Long
    currentRow = 5   ' 4 lignes vides en haut pour le bouton

    Dim key As Variant
    For Each key In dictRessources.Keys

        Dim blockStartRow As Long
        blockStartRow = currentRow

        ' --- En-tête du bloc ---
        shDest.Cells(currentRow, 1).Resize(1, nbCols).Value = headers
        With shDest.Cells(currentRow, 1).Resize(1, nbCols)
            .Interior.Color = RGB(83, 141, 213)
            .Font.Color = RGB(255, 255, 255)
            .Font.Bold = True
        End With
        currentRow = currentRow + 1

        Dim firstDataRow As Long
        firstDataRow = currentRow

        Dim tgListArr() As String
        Dim tgCount As Long
        tgCount = 0
        ReDim tgListArr(0 To nbRows)

        Dim isOrange As Boolean
        isOrange = True
        Dim c As Long

        For r = 1 To nbRows
            If dataSource(r, colRessource) = key Then

                ' Colonnes Ressource / TG / Charge : valeurs brutes
                shDest.Cells(currentRow, colRessource).Value = dataSource(r, colRessource)
                shDest.Cells(currentRow, colTG).Value = dataSource(r, colTG)
                shDest.Cells(currentRow, colCharge).Value = dataSource(r, colCharge)

                ' Mémorise ce TG pour la liste déroulante
                tgListArr(tgCount) = dataSource(r, colTG)
                tgCount = tgCount + 1

                ' Écriture des valeurs % brutes dans les colonnes cachées (miroir)
                For c = firstMonthCol To nbCols
                    Dim helperCol As Long
                    helperCol = helperColOffset + (c - firstMonthCol)
                    shDest.Cells(currentRow, helperCol).Value = dataSource(r, c)
                Next c

                With shDest.Cells(currentRow, 1).Resize(1, nbCols)
                    If isOrange Then
                        .Interior.Color = RGB(253, 233, 217)
                    Else
                        .Interior.ColorIndex = xlNone
                    End If
                End With
                isOrange = Not isOrange

                currentRow = currentRow + 1
            End If
        Next r

        Dim lastDataRow As Long
        lastDataRow = currentRow - 1

        ' --- Colonne Charge en gris (hors en-tête) ---
        With shDest.Range(shDest.Cells(firstDataRow, colCharge), shDest.Cells(lastDataRow, colCharge))
            .Interior.Color = RGB(191, 191, 191)
            .Font.Color = RGB(0, 0, 0)
            .NumberFormat = "0 ""h"""
        End With

        Dim summaryRow As Long
        summaryRow = currentRow

        Dim hCol As String

        ' --- Formule des cellules de mois pour chaque ligne de données ---
        For r = firstDataRow To lastDataRow
            For c = firstMonthCol To nbCols
                helperCol = helperColOffset + (c - firstMonthCol)
                hCol = ColLetter(helperCol)

                shDest.Cells(r, c).Formula = _
                    "=IF($" & ColLetter(colTG) & r & "=$" & ColLetter(colTG) & summaryRow & _
                    ",MAX(0,(" & hCol & r & "-MAX(0,SUM(" & hCol & firstDataRow & ":" & hCol & lastDataRow & ")-1))*7.5)" & _
                    "," & hCol & r & "*7.5)"
            Next c
        Next r

        shDest.Range(shDest.Cells(firstDataRow, firstMonthCol), shDest.Cells(lastDataRow, nbCols)).NumberFormat = "0.00"" h"""

        ' --- Ligne de synthèse : dropdown TG protégé + somme des heures par mois ---
        shDest.Cells(summaryRow, 1).Value = "Total heures"
        shDest.Cells(summaryRow, 1).HorizontalAlignment = xlCenter

        For c = firstMonthCol To nbCols
            shDest.Cells(summaryRow, c).Formula = "=SUM(" & _
                shDest.Cells(firstDataRow, c).Address(False, False) & ":" & _
                shDest.Cells(lastDataRow, c).Address(False, False) & ")"
        Next c
        shDest.Range(shDest.Cells(summaryRow, firstMonthCol), shDest.Cells(summaryRow, nbCols)).NumberFormat = "0.00"" h"""

        With shDest.Cells(summaryRow, 1).Resize(1, nbCols)
            .Interior.Color = RGB(220, 220, 220)
            .Font.Bold = True
        End With

        ' --- Coloration conditionnelle : vert si entre 7,2h et 7,5h inclus, rouge sinon ---
        For c = firstMonthCol To nbCols
            Dim totalVal As Double
            totalVal = shDest.Cells(summaryRow, c).Value
            If totalVal >= 7.2 And totalVal <= 7.5 Then
                shDest.Cells(summaryRow, c).Font.Color = RGB(0, 160, 80)
            Else
                shDest.Cells(summaryRow, c).Font.Color = RGB(255, 0, 0)
            End If
        Next c

        ' --- Liste déroulante sur la case TG de la ligne de synthèse ---
        With shDest.Cells(summaryRow, colTG).Validation
            .Delete
            .Add Type:=xlValidateList, AlertStyle:=xlValidAlertStop, _
                Formula1:="," & Join(FilterUnique(tgListArr, tgCount), ",")
        End With
        shDest.Cells(summaryRow, colTG).Interior.Color = RGB(255, 255, 204)

        Dim blockEndRow As Long
        blockEndRow = summaryRow
        currentRow = currentRow + 1

        ' --- Bordures sur le bloc visible uniquement ---
        With shDest.Range(shDest.Cells(blockStartRow, 1), shDest.Cells(blockEndRow, nbCols)).Borders
            .LineStyle = xlContinuous
            .Weight = xlThin
            .ColorIndex = xlAutomatic
        End With

        currentRow = currentRow + 1
    Next key

    ' --- Masque les colonnes helper ---
    shDest.Range(shDest.Cells(1, helperColOffset), shDest.Cells(1, helperColOffset + numMonthCols - 1)).EntireColumn.Hidden = True

    shDest.Columns.AutoFit

    Exit Sub

errorHandler:
    MsgBox "Erreur lors de la génération du tableau heures : " & Err.Description
    Debug.Assert False
End Sub

' Convertit un numéro de colonne en lettre (ex: 28 -> "AB")
Private Function ColLetter(ByVal colNum As Long) As String
    Dim addr As String
    addr = Cells(1, colNum).Address(False, False)
    ColLetter = Left$(addr, Len(addr) - 1)
End Function

' Retire les doublons d'un tableau de chaînes
Private Function FilterUnique(arr() As String, ByVal count As Long) As Variant
    Dim dict As Object
    Set dict = CreateObject("Scripting.Dictionary")
    Dim i As Long
    For i = 0 To count - 1
        If Not dict.Exists(arr(i)) Then dict.Add arr(i), Nothing
    Next i
    FilterUnique = dict.Keys
End Function
