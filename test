' --- Mise en forme conditionnelle : vert si entre 96% et 100% de 7,5h (7,2h à 7,5h), rouge sinon ---
Dim rngSummary As Range
Set rngSummary = shDest.Range(shDest.Cells(summaryRow, firstMonthCol), shDest.Cells(summaryRow, nbCols))

rngSummary.FormatConditions.Delete

' Règle verte : entre 7,2 et 7,5 inclus
With rngSummary.FormatConditions.Add(Type:=xlCellValue, Operator:=xlBetween, Formula1:="7.2", Formula2:="7.5")
    .Font.Color = RGB(0, 160, 80)
End With

' Règle rouge : en dehors de cette plage
With rngSummary.FormatConditions.Add(Type:=xlCellValue, Operator:=xlNotBetween, Formula1:="7.2", Formula2:="7.5")
    .Font.Color = RGB(255, 0, 0)
End With
